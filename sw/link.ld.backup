/*
記憶體地址     區域          大小       用途
-----------  -----------  ---------  --------------------------
0x00000000  ┌───────────┐
            │  .text.init │  可變      重置向量 (啟動程式碼)
0x00000100  ├───────────┤
            │ .text.vec  │  可變      例外向量表
            ├───────────┤
            │   .text    │  可變      主程式碼
            ├───────────┤
            │  .rodata   │  可變      唯讀資料 (常數、字串)
            ├───────────┤
            │    ...     │            未使用空間
0x0000FFFF  └───────────┘  (ROM 結束)

0x00010000  ┌───────────┐
            │   .data    │  可變      已初始化變數 (從 ROM 複製)
            ├───────────┤
            │    .bss    │  可變      未初始化變數 (啟動時清零)
            ├───────────┤
            │    堆積    │  可選      動態記憶體分配 (malloc/free)
            │    ...     │            
            │    堆疊    │  向下生長  函數呼叫、局部變數
0x0001F000  │ 堆疊頂端   │  4KB       堆疊頂部 (預留安全邊界)
            │    ...     │            
0x0001FFFF  └───────────┘  (RAM 結束)
*/

/* ===========================================================================
 * link.ld - RISC-V 處理器記憶體連結腳本
 * 功能：定義程式記憶體佈局，控制程式碼和資料在記憶體中的位置
 * 適用於：BearCore-V RISC-V 處理器
 * 記憶體配置：
 *   ROM: 0x00000000 - 0x0000FFFF (64KB) - 存放程式碼和唯讀資料
 *   RAM: 0x00010000 - 0x0001FFFF (64KB) - 存放可變資料和堆疊
 * =========================================================================== */

/* 定義記憶體區域 (MEMORY Regions) */
MEMORY
{
    /* 
     * ROM (唯讀記憶體) - 存放程式碼和唯讀資料
     * ORIGIN: 起始地址 0x00000000
     * LENGTH: 長度 64KB (0x10000)
     * ATTRIBUTES: rx (可讀、可執行)
     */
    ROM (rx)  : ORIGIN = 0x00000000, LENGTH = 128K
    
    /*
     * RAM (隨機存取記憶體) - 存放可變資料、堆疊和堆積
     * ORIGIN: 起始地址 0x00010000 (緊接在 ROM 之後)
     * LENGTH: 長度 64KB (0x10000)
     * ATTRIBUTES: rwx (可讀、可寫、可執行)
     * 注意：RWX 權限在嵌入式系統中常見，但生產環境可能需要更嚴格限制
     */
    RAM (rwx) : ORIGIN = 0x00020000, LENGTH = 128K
}

/* 定義段 (SECTIONS) - 控制各種類型的資料在記憶體中的位置 */
SECTIONS
{
    /* 
     * ENTRY 指令：指定程式入口點
     * 處理器重置後從 _start 標籤開始執行
     * 對應組合語言中的 .global _start
     */
    ENTRY(_start)

    /* =======================================================================
     * 🏆 1. 重置向量段 (Reset Vector Section)
     * 位置：ROM 的最開頭 (0x00000000)
     * 功能：處理器重置後執行的第一段程式碼
     * 對齊：4 位元組對齊 (RISC-V 指令為 32 位元 = 4 位元組)
     * ======================================================================= */
    .text.init 0x00000000 : {
        /* 
         * KEEP 指令：確保此段不會被連結器優化掉，即使沒有被引用
         * 這對於啟動程式碼至關重要，必須保留
         */
        KEEP(*(.text.init))
    } > ROM  /* 將此段放置在 ROM 記憶體區域 */

    /* =======================================================================
     * 🏆 2. 例外向量段 (Exception Vector Section)
     * 位置：ROM 的 0x00000100
     * 功能：處理例外和中斷的處理程式碼
     * RISC-V 架構約定：例外向量通常放在 0x100 或對齊到 4KB 邊界
     * ======================================================================= */
    .text.vec 0x00000100 : {
        . = ALIGN(4);  /* 確保 4 位元組對齊，RISC-V 指令必須對齊 */
        KEEP(*(.text.vec))  /* 保留所有例外處理程式碼 */
    } > ROM

    /* =======================================================================
     * 🏆 3. 主程式碼段 (Main Text Section)
     * 位置：自動安排在例外向量段之後
     * 功能：存放 C/C++ 和組合語言的主要程式碼
     * 包含：函數定義、程式邏輯等
     * ======================================================================= */
    .text : {
        . = ALIGN(4);  /* 4 位元組對齊，確保指令正確對齊 */
        /*
         * *(.text .text.*) 通配符：
         *   .text: 標準程式碼段
         *   .text.*: 編譯器生成的額外套件程式碼段
         */
        *(.text .text.*)
    } > ROM

    /* =======================================================================
     * 🏆 唯讀資料段 (Read-Only Data Section)
     * 位置：接在主程式碼段之後
     * 功能：存放常數、字串常量和編譯時已知的唯讀資料
     * 特殊對齊：對齊到 256 位元組邊界，有助於快取效率
     * ======================================================================= */
    .rodata : {
        . = ALIGN(256);  /* 256 位元組對齊，提高快取效能 */
        *(.rodata .rodata.*)      /* 唯讀資料 */
        *(.srodata .srodata.*)    /* 小型唯讀資料（某些編譯器使用） */
    } > ROM

    /* =======================================================================
     * 🏆 4. 初始化資料段 (Initialized Data Section)
     * 虛擬記憶體地址 (VMA): RAM 區域 (0x00010000 開始)
     * 加載記憶體地址 (LMA): ROM 區域
     * 
     * 重要概念：
     *   VMA (Virtual Memory Address): 程式執行時資料所在的地址
     *   LMA (Load Memory Address):   程式載入時資料所在的地址
     *   
     * 嵌入式系統常見模式：
     *   1. 初始化資料編譯時存放在 ROM 中
     *   2. 啟動時從 ROM 複製到 RAM
     *   3. 執行時從 RAM 讀寫這些資料
     * ======================================================================= */
    .data : ALIGN(8) {  /* 8 位元組對齊，適合 64 位元資料存取 */
        /*
         * 定義符號供啟動程式碼使用：
         *   _data_vma_start: RAM 中 .data 段的起始地址
         *   _data_vma_end:   RAM 中 .data 段的結束地址
         */
        _data_vma_start = .;  /* '.' 表示當前位置計數器 */
        
        *(.data .data.*)    /* 已初始化全域和靜態變數 */
        *(.sdata .sdata.*)  /* 小型已初始化資料 */
        
        . = ALIGN(8);  /* 結束時對齊到 8 位元組 */
        _data_vma_end = .;  /* 定義結束地址符號 */
    } > RAM AT > ROM  /* VMA 在 RAM，LMA 在 ROM */

    /*
     * 定義 LMA 起始地址符號
     * LOADADDR(.data): 獲取 .data 段的加載地址（ROM 中的地址）
     * 啟動程式碼使用此符號找到 ROM 中資料的起始位置
     */
    _data_lma_start = LOADADDR(.data);

    /* =======================================================================
     * 🏆 未初始化資料段 (Uninitialized Data Section, BSS)
     * 位置：RAM 區域，接在 .data 段之後
     * 功能：存放未初始化的全域和靜態變數
     * 特點：在執行檔中不佔空間，啟動時需要清零
     * BSS = Block Started by Symbol
     * ======================================================================= */
    .bss : ALIGN(4) {
        _bss_start = .;  /* 定義 BSS 段起始地址符號 */
        
        *(.bss .bss.*)  /* 未初始化全域和靜態變數 */
        *(COMMON)       /* 未初始化的全域變數（C 語言） */
        
        . = ALIGN(4);   /* 4 位元組對齊 */
        _bss_end = .;   /* 定義 BSS 段結束地址符號 */
    } > RAM

    /* =======================================================================
     * 🏆 堆疊頂端定義 (Stack Top Definition)
     * 位置：RAM 的最高處 (0x0001F000)
     * 
     * 計算方式：
     *   RAM 起始: 0x00010000
     *   RAM 長度: 64KB = 0x00010000
     *   RAM 結束: 0x00010000 + 0x00010000 = 0x00020000
     *   
     *   選擇 0x0001F000 作為堆疊頂端的原因：
     *     - 留下 4KB (0x1000) 空間作為安全邊界
     *     - 防止堆疊溢出破壞其他資料
     *     - 符合堆疊向下生長的特性
     * ======================================================================= */
    /* 堆疊配置（放在 RAM 頂部） */
    _stack_bottom = ORIGIN(RAM) + LENGTH(RAM);  /* 堆疊底部（高地址） */
    _stack_top = _stack_bottom - 4K;           /* 堆疊頂部（低地址），4KB 堆疊 */

    /* =======================================================================
     * 🏆 丟棄段 (Discarded Sections)
     * 功能：明確丟棄不需要的段，減小執行檔大小
     * 包含：調試資訊、註解、架構屬性等
     * ======================================================================= */
    /DISCARD/ : {
        *(.comment)              /* 編譯器註解 */
        *(.riscv.attributes)     /* RISC-V 架構屬性 */
        /* 
         * 可根據需要添加其他不需要的段：
         * *(.debug*)            // 調試資訊（發佈版本中不需要）
         * *(.note*)             // 編譯器註記
         */
    }
    
    /* =======================================================================
     * 🏆 可選：堆積區域定義 (Optional Heap Region Definition)
     * 如果需要動態記憶體分配，可以定義堆積區域
     * 位置：BSS 段結束後到堆疊開始前
     * ======================================================================= */
    /*
    _heap_start = _bss_end;     // 堆積起始地址
    _heap_end = _stack_top - 0x1000;  // 堆積結束地址，預留 4KB 給堆疊
    */
}